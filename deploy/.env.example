# Copy to deploy/.env for the local docker compose stack. Never commit deploy/.env.

# --- Required -----------------------------------------------------------------------------
# Signs login sessions. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NEXOPS_SECRET_KEY=
# Shared secret for HMAC-signed deployment webhooks from CI. Generate the same way.
NEXOPS_WEBHOOK_SECRET=
# First administrator (created on first start only).
NEXOPS_ADMIN_EMAIL=admin@example.com
NEXOPS_ADMIN_PASSWORD=
NEXOPS_ADMIN_NAME=NexOps Admin

# --- Optional integrations ----------------------------------------------------------------
# Free API key from https://console.groq.com/keys - enables LLM investigation + postmortems.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fine-grained token: Contents:read (diffs) + Actions:read/write (rollback workflow dispatch).
GITHUB_TOKEN=
# Slack or Discord incoming webhook for incident/approval alerts.
NEXOPS_NOTIFY_WEBHOOK_URL=
# Bearer token applications use to read feature flags (/api/flags/evaluate). Empty = open read.
NEXOPS_FLAGS_TOKEN=
# AWS CloudWatch/EC2/ECR (uses ~/.aws or instance role credentials).
AWS_INTEGRATION_ENABLED=false
AWS_REGION=us-east-1

# --- Local tuning -------------------------------------------------------------------------
NEXOPS_MONITOR_INTERVAL_SECONDS=15
NEXOPS_DEPLOYMENT_VERIFICATION_MINUTES=5
PROMETHEUS_RATE_WINDOW=1m
TRAFFIC_RPS=8
NEXOPS_DB_PASSWORD=nexops_local_dev_only
PAYMENTS_DB_PASSWORD=payments_local_dev_only
GRAFANA_ADMIN_PASSWORD=admin_local_dev_only
