# backend/.env — only for running the API/worker directly on your machine (uvicorn / python -m app.worker).
# The docker compose stack uses deploy/.env instead. Full reference: docs/ENVIRONMENT.md

# --- Core (required) ----------------------------------------------------------------------
# The compose stack publishes its database on 127.0.0.1:5433.
DATABASE_URL=postgresql+psycopg://nexops:nexops_local_dev_only@127.0.0.1:5433/nexops
NEXOPS_SECRET_KEY=change-me-to-a-long-random-string
NEXOPS_WEBHOOK_SECRET=change-me-to-another-long-random-string
NEXOPS_ADMIN_EMAIL=admin@example.com
NEXOPS_ADMIN_PASSWORD=change-me-please
NEXOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEXOPS_PUBLIC_URL=http://localhost:5173

# Run the monitor inside the API process (convenient locally; use `python -m app.worker` in production).
NEXOPS_RUN_WORKER_IN_API=true
NEXOPS_MONITOR_INTERVAL_SECONDS=15

# --- Telemetry (optional; each one enables a provider) ------------------------------------
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_RATE_WINDOW=1m
LOKI_URL=http://127.0.0.1:3100
DOCKER_ENABLED=true
# KUBERNETES_ENABLED=true
# KUBECONFIG=~/.kube/config
# AWS_INTEGRATION_ENABLED=true
# AWS_REGION=us-east-1

# --- AI + source control (optional) -------------------------------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GITHUB_TOKEN=github_pat_...
